{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Neuro Engine",
  "version": "0.1.0",
  "identifier": "dev.neuro-engine.embodied-lab",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Neuro Engine · Embodied Learning Lab",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": { "active": false }
}
